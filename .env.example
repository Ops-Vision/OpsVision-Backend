# Server
SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/opsvision
DB_USERNAME=opsvision
DB_PASSWORD=opsvision

# GitHub REST API (use GITHUB_API_TOKEN — avoid GITHUB_TOKEN collision with CI)
GITHUB_API_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_CONNECT_TIMEOUT_MS=5000
# GITHUB_READ_TIMEOUT_MS=15000

# AI / LLM. Disabled by default. Prefer Ollama for local demos.
# OPSVISION_AI_ENABLED=false
# OPSVISION_AI_PROVIDER=none
#
# --- Ollama (first-class; native /api/chat) ---
# OPSVISION_AI_ENABLED=true
# OPSVISION_AI_PROVIDER=ollama
# OPSVISION_OLLAMA_BASE_URL=http://localhost:11434
# OPSVISION_OLLAMA_MODEL=llama3.2
#
# --- OpenAI-compatible (cloud or proxies) ---
# OPSVISION_AI_PROVIDER=openai-compatible
# OPSVISION_AI_BASE_URL=https://api.openai.com/v1
# OPSVISION_AI_API_KEY=
# OPSVISION_AI_MODEL=gpt-4o-mini
#
# Shared generation / HTTP timeouts
# OPSVISION_AI_CONNECT_TIMEOUT_MS=5000
# OPSVISION_AI_READ_TIMEOUT_MS=60000
# OPSVISION_AI_MAX_TOKENS=800
# OPSVISION_AI_TEMPERATURE=0.2

# Observability (Kubernetes + Prometheus). Disabled by default.
# OPSVISION_OBSERVABILITY_ENABLED=false
# OPSVISION_K8S_ENABLED=true
# OPSVISION_K8S_API_BASE_URL=https://kubernetes.default.svc
# OPSVISION_K8S_TOKEN=
# OPSVISION_K8S_NAMESPACE=default
# OPSVISION_K8S_WORKLOAD=
# OPSVISION_K8S_CONNECT_TIMEOUT_MS=5000
# OPSVISION_K8S_READ_TIMEOUT_MS=15000
# OPSVISION_PROMETHEUS_ENABLED=true
# OPSVISION_PROMETHEUS_BASE_URL=http://localhost:9090
# OPSVISION_PROMETHEUS_SERVICE_SELECTOR=job="my-app"
# Optional explicit PromQL overrides (otherwise defaults use service-selector):
# OPSVISION_PROMETHEUS_REQUEST_RATE_QUERY=
# OPSVISION_PROMETHEUS_ERROR_RATE_QUERY=
# OPSVISION_PROMETHEUS_LATENCY_P95_QUERY=
# OPSVISION_PROMETHEUS_CPU_QUERY=
# OPSVISION_PROMETHEUS_MEMORY_QUERY=
# OPSVISION_PROMETHEUS_AVAILABILITY_QUERY=

# Incident detection thresholds (deterministic)
# OPSVISION_INCIDENT_ERROR_RATIO_THRESHOLD=0.05
# OPSVISION_INCIDENT_ERROR_RATE_THRESHOLD=1.0
# OPSVISION_INCIDENT_AVAILABILITY_MIN=0.95
# OPSVISION_INCIDENT_POD_RESTART_THRESHOLD=3
# OPSVISION_INCIDENT_WARNING_EVENT_THRESHOLD=1
# OPSVISION_INCIDENT_DETECT_UNHEALTHY_WORKLOAD=true
# OPSVISION_INCIDENT_REQUIRE_TELEMETRY=true

# Optional JVM flags when running the JAR/container
JAVA_OPTS=

# --- Demo quick-start ---
# Full stack (API http://localhost:8082, Postgres host port 5433):
#   docker compose up -d --build
# DB only + Maven on host:
#   docker compose up -d postgres
#   set DB_URL=jdbc:postgresql://localhost:5433/opsvision
#   mvn spring-boot:run   -> http://localhost:8080
# 2. cp .env.example .env   (fill tokens only if needed)
# 3. Open Swagger: http://localhost:8082/swagger-ui.html (full stack)
# 4. Follow docs/DEMO.md (sample bodies in docs/demo/)
